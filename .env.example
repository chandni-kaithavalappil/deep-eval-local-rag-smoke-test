DEEPEVAL_TELEMETRY_OPT_OUT=YES

# Working smoke-test defaults.
# LLM providers: ollama, openai, anthropic
# Embedding providers: ollama, openai
RAG_LLM_PROVIDER=ollama
RAG_LLM_MODEL=llama3.2:1b
RAG_EMBED_PROVIDER=ollama
RAG_EMBED_MODEL=nomic-embed-text
RAG_EMBED_DIM=768
RAG_EMBED_MAX_TOKENS=8192
OLLAMA_HOST=http://localhost:11434

# OpenAI option:
# RAG_LLM_PROVIDER=openai
# RAG_LLM_MODEL=gpt-4o-mini
# RAG_EMBED_PROVIDER=openai
# RAG_EMBED_MODEL=text-embedding-3-small
# RAG_EMBED_DIM=1536
# OPENAI_API_KEY=replace-with-your-real-key

# Claude option for generation/extraction only. Use ollama or openai for embeddings.
# RAG_LLM_PROVIDER=anthropic
# RAG_LLM_MODEL=claude-sonnet-4-6-20250514
# RAG_LLM_MAX_TOKENS=4096
# ANTHROPIC_API_KEY=replace-with-your-real-key

# DeepEval judge model. Providers: ollama, openai, anthropic
DEEPEVAL_PROVIDER=ollama
DEEPEVAL_MODEL=llama3.2:1b
DEEPEVAL_OLLAMA_CAPABILITY_MODEL=llama3.2
DEEPEVAL_TEMPERATURE=0
DEEPEVAL_MAX_TOKENS=1024

# Helpful local-demo overrides for context-heavy metrics:
# DEEPEVAL_CONTEXT_CHAR_LIMIT=2500
# DEEPEVAL_INCLUDE_REASON=false
# DEEPEVAL_MAX_CONCURRENT=1

# DeepEval OpenAI judge option:
# DEEPEVAL_PROVIDER=openai
# DEEPEVAL_MODEL=gpt-4o-mini
# DEEPEVAL_API_KEY=replace-with-your-real-key

# DeepEval Claude judge option:
# DEEPEVAL_PROVIDER=anthropic
# DEEPEVAL_MODEL=claude-sonnet-4-6-20250514
# DEEPEVAL_API_KEY=replace-with-your-real-key
